name: CD DEV Pipeline

on:
  pull_request:
    types:
      - closed
    branches:
      - devel

permissions:
  contents: read
  actions: read
  pull-requests: read
  id-token: write

env:
  AWS_REGION: us-east-1

jobs:
  deploy:
    name: Deploy to S3
    runs-on: ubuntu-latest
    environment: dev
    if: github.event.pull_request.merged == true

    steps:
        id: find-build
        uses: actions/github-script@v7
        with:
          script: |
            const pr = context.payload.pull_request;

            const runs = await github.rest.actions.listWorkflowRuns({
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: "ci-dev.yml",
              event: "pull_request",
              status: "success",
              per_page: 100
            });

            const matchingRun = runs.data.workflow_runs
              .filter(run =>
                run.pull_requests?.some(item =>
                  item.number === pr.number &&
                  (!item.head?.sha || item.head.sha === pr.head.sha)
                )
              )
              .sort((a, b) =>
                new Date(b.created_at) - new Date(a.created_at)
              )[0];

            if (!matchingRun) {
              core.setFailed(
                `No successful CI build found for PR #${pr.number}`
              );
              return;
            }

            core.info(`CI Run ID: ${matchingRun.id}`);
            core.info(`CI Commit: ${matchingRun.head_sha}`);
            core.setOutput("run_id", String(matchingRun.id));

      - name: Download Build
        uses: actions/download-artifact@v4
        with:
          name: Build
          path: ./app/build
          github-token: ${{ github.token }}
          repository: ${{ github.repository }}
          run-id: ${{ steps.find-build.outputs.run_id }}

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: ${{ vars.AWS_ROLE_ARN_APPLY }}
          aws-region: ${{ env.AWS_REGION }}
          role-session-name: GitHubActions-Dev-Pipeline

      - name: Verify AWS Identity
        run: aws sts get-caller-identity

      - name: Deploy S3
        uses: reggionick/s3-deploy@v4
        with:
          folder: ./app/build
          bucket: ${{ secrets.S3_BUCKET }}
          bucket-region: ${{ env.AWS_REGION }}